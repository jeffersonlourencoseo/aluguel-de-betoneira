---
import SEO from '../components/SEO.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { FAQItem } from '../components/SchemaGraph.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import { SITE_CONFIG } from '../data/config';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object | object[];
  faq?: FAQItem[];
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ItemPage';
  servicos?: Array<{ title: string }>;
  breadcrumbName?: string;
  type?: string;
  pubDate?: string;
  updatedDate?: string;
  preloadHero?: boolean;
}

const { title, description = SITE_CONFIG.description, keywords, canonical, ogImage, noindex, schema, faq, pageType, servicos, breadcrumbName, type, pubDate, updatedDate, preloadHero } = Astro.props;
const path = canonical ?? Astro.url.pathname;
const schemaPath = path === '/' ? '/' : path.endsWith('/') ? path : `${path}/`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      preloadHero={preloadHero}
    />

    <!-- Schema.org JSON-LD: um unico script com @graph -->
    <SchemaGraph
      title={title}
      description={description}
      path={schemaPath}
      pageType={pageType}
      servicos={servicos}
      breadcrumbName={breadcrumbName}
      faq={faq}
      nodes={schema}
    />

    <!-- Google Tag Manager: main thread, carregado depois do load/ocioso ou na 1a interacao (nao pesa no LCP) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      (function () {
        var ATRASO_GTM = 8000;
        var carregado = false;
        function carregarGTM() {
          if (carregado) return;
          carregado = true;
          ['scroll', 'click', 'touchstart', 'keydown'].forEach(function (ev) {
            window.removeEventListener(ev, carregarGTM);
          });
          var j = document.createElement('script');
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-TZBXS6HT';
          document.head.appendChild(j);
        }
        ['scroll', 'click', 'touchstart', 'keydown'].forEach(function (ev) {
          window.addEventListener(ev, carregarGTM, { once: true, passive: true });
        });
        window.addEventListener('load', function () {
          setTimeout(function () {
            if ('requestIdleCallback' in window) window.requestIdleCallback(carregarGTM, { timeout: 3500 });
            else carregarGTM();
          }, ATRASO_GTM);
        });
      })();
    </script>
  </head>

  <body class="font-sans antialiased text-gray-900 bg-white">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TZBXS6HT" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <slot />
    <WhatsAppBtn />

    <!-- Eventos: le data-evento / data-local e envia ao dataLayer (GTM na main thread) -->
    <script is:inline>
      (function () {
        function enviarEvento(nome, local) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: nome, local_botao: local || 'sem-local', transport_type: 'beacon' });
        }
        document.addEventListener('click', function (e) {
          var el = e.target.closest ? e.target.closest('[data-evento]') : null;
          if (el) enviarEvento(el.getAttribute('data-evento'), el.getAttribute('data-local'));
        });
        document.addEventListener('submit', function (e) {
          var f = e.target.closest ? e.target.closest('[data-evento-envio]') : null;
          if (f) enviarEvento(f.getAttribute('data-evento-envio'), f.getAttribute('data-local') || 'contato');
        });
      })();
    </script>

    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              var d = parseInt(el.dataset.stagger || '0', 10) * 100;
              setTimeout(function () { el.classList.add('is-visible'); }, d);
              obs.unobserve(el);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { obs.observe(el); });
      })();
    </script>
  </body>
</html>
