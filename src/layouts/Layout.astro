---
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object;
  servicos?: Array<{ title: string }>;
  breadcrumbName?: string;
  type?: string;
  pubDate?: string;
  updatedDate?: string;
  preloadHero?: boolean;
}

const { title, description, keywords, canonical, ogImage, noindex, schema, servicos, breadcrumbName, type, pubDate, updatedDate, preloadHero } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      preloadHero={preloadHero}
    />

    <!-- Schema.org JSON-LD — LocalBusiness + WebSite + Organization -->
    <SchemaLocalBusiness servicos={servicos} breadcrumbName={breadcrumbName} />

    <!-- Schema adicional por página (opcional) -->
    {
      schema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    }

    <!-- Google tag (gtag.js) — carregamento adiado para não bloquear a thread principal -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9BR79QVSZ4', { send_page_view: false, transport_type: 'beacon' });
      function loadGtag() {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-9BR79QVSZ4';
        document.head.appendChild(s);
        gtag('event', 'page_view', { send_to: 'G-9BR79QVSZ4' });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGtag, { timeout: 2000 });
      } else {
        window.addEventListener('load', loadGtag);
      }
    </script>
  </head>

  <body class="font-sans antialiased text-gray-900 bg-white">
    <slot />
    <WhatsAppBtn />

    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              var d = parseInt(el.dataset.stagger || '0', 10) * 100;
              setTimeout(function () { el.classList.add('is-visible'); }, d);
              obs.unobserve(el);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { obs.observe(el); });
      })();
    </script>

    <!-- Rastreamento de cliques em telefone e WhatsApp (eventos GA4) -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a || typeof gtag !== 'function') return;
        var href = a.getAttribute('href') || '';
        var evento = null;
        if (href.indexOf('tel:') === 0) evento = 'click_telefone';
        else if (href.indexOf('wa.me/') !== -1 || href.indexOf('api.whatsapp.com') !== -1) evento = 'click_whatsapp';
        if (!evento) return;
        gtag('event', evento, {
          send_to: 'G-9BR79QVSZ4',
          link_url: href.split('?')[0],
          link_text: (a.textContent || '').trim().slice(0, 60),
          page_path: location.pathname,
          transport_type: 'beacon'
        });
      }, true);
    </script>
  </body>
</html>
