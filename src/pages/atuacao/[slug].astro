---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { SITE_CONFIG, whatsappUrl } from '../../data/config';
import metas from '../../data/metas.json';

export async function getStaticPaths() {
  const locais = await getCollection('atuacao');
  return locais.map((local) => ({ params: { slug: local.slug }, props: { local } }));
}

const { local } = Astro.props;
const { Content } = await local.render();
const title = metas[local.slug].title;
const description = metas[local.slug].description;
const pageUrl = `${SITE_CONFIG.url}/atuacao/${local.slug}/`;
const area = SITE_CONFIG.atuacao.find((a) => a.slug === local.slug);

// Service com o areaServed deste local (sem Review/aggregateRating)
const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: local.data.title,
  serviceType: 'Aluguel de betoneira',
  description,
  url: pageUrl,
  provider: { '@id': `${SITE_CONFIG.url}/#localbusiness` },
  areaServed: { '@type': 'Place', name: `${area?.nome ?? local.data.local}, ${area?.municipio ?? 'Rio de Janeiro'}`, containedInPlace: { '@type': 'City', name: area?.municipio ?? 'Rio de Janeiro' } },
};
const faqItems = local.data.faq;
---

<Layout title={title} description={description} canonical={`/atuacao/${local.slug}/`} schema={serviceSchema} faq={faqItems} pageType="WebPage" breadcrumbName={`Aluguel de betoneira em ${local.data.local}`} preloadHero={false}>
  <Header currentPath="/atuacao" />

  <main>
    <section class="relative py-24 lg:py-32 bg-gray-900 overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/hero-blur-1200.webp"
          srcset="/images/hero-blur-640.webp 640w, /images/hero-blur-960.webp 960w, /images/hero-blur-1200.webp 1200w"
          sizes="100vw"
          alt={`Betoneira em obra de construção civil em ${local.data.local}, Rio de Janeiro`}
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="795"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-[#1A1A1A]/90 via-[#2D2D2D]/85 to-[#4A4A4A]/75"></div>
      </div>
      <div class="relative container mx-auto px-6 sm:px-8 lg:px-12 max-w-5xl">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-gray-100 mb-6">
          <a href="/" class="hover:text-primary transition-colors">Início</a>
          <span>/</span>
          <a href="/servicos/" class="hover:text-primary transition-colors">Serviços</a>
          <span>/</span>
          <span class="text-white">{local.data.local}</span>
        </nav>
        <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight mb-10">{local.data.title}</h1>
        <p class="text-lg text-gray-100 max-w-2xl mb-10">Betoneiras de 120L a 400L com entrega na obra e orçamento grátis pelo WhatsApp.</p>
        <a
          href={whatsappUrl}
          data-evento="clique_whatsapp"
          data-local={`atuacao-${local.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-whatsapp px-10 py-5 text-lg font-bold text-white shadow-xl hover:bg-whatsapp-dark hover:scale-105 active:scale-95 transition-all"
        >
          Pedir Orçamento no WhatsApp
        </a>
      </div>
    </section>

    <section class="py-24 lg:py-32 bg-white">
      <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-5xl">
        <div class="max-w-3xl mx-auto">
          <article class="prose prose-lg prose-gray max-w-none">
            <Content />
          </article>
          <FAQSection items={faqItems} />
          <div class="mt-16 flex flex-col sm:flex-row gap-4">
            <a href="/servicos/" class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-secondary px-8 py-4 text-base font-bold text-white hover:bg-secondary-700 hover:scale-105 active:scale-95 transition-all">Ver todos os modelos</a>
            <a
              href={SITE_CONFIG.telefoneLink}
              data-evento="clique_telefone"
              data-local={`atuacao-${local.slug}`}
              class="inline-flex min-h-[48px] items-center justify-center rounded-full border-2 border-secondary px-8 py-4 text-base font-bold text-secondary hover:bg-secondary/5 hover:scale-105 active:scale-95 transition-all"
            >Ligar Agora</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
