---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { SITE_CONFIG, whatsappUrl } from '../../data/config';
import metas from '../../data/metas.json';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((servico) => ({
    params: { slug: servico.slug },
    props: { servico },
  }));
}

const { servico } = Astro.props;
const { Content } = await servico.render();

const title = metas[servico.slug].title;
const description = metas[servico.slug].description;
const keywords = servico.data.keywords;

const pageUrl = `${SITE_CONFIG.url}/servicos/${servico.slug}/`;
const imageUrl = `${SITE_CONFIG.url}${servico.data.image || SITE_CONFIG.ogImage}`;

const precoMin = { 'betoneira-120l': 80, 'betoneira-150l': 100, 'betoneira-200l': 130, 'betoneira-400l': 250 };
// Service (preco inicial da diaria; sem aggregateRating/review nao ha Offer valido para Product; nada de preco inventado)
const productSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: servico.data.title,
  serviceType: 'Aluguel de betoneira',
  description: servico.data.description,
  url: pageUrl,
  image: imageUrl,
  provider: { '@id': `${SITE_CONFIG.url}/#localbusiness` },
  areaServed: { '@type': 'City', name: SITE_CONFIG.areaServed },
  ...(precoMin[servico.slug]
    ? {
        offers: {
          '@type': 'Offer',
          url: pageUrl,
          priceCurrency: 'BRL',
          availability: 'https://schema.org/InStock',
          priceSpecification: { '@type': 'PriceSpecification', minPrice: precoMin[servico.slug], priceCurrency: 'BRL' },
          seller: { '@id': `${SITE_CONFIG.url}/#localbusiness` },
        },
      }
    : {}),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Capacidade', value: servico.data.capacidade },
    ...(servico.data.motor ? [{ '@type': 'PropertyValue', name: 'Motor', value: servico.data.motor }] : []),
    ...(servico.data.peso ? [{ '@type': 'PropertyValue', name: 'Peso', value: servico.data.peso }] : []),
  ],
};

const faqData = {
  'betoneira-120l': [
    { name: "Quanto custa alugar uma betoneira 120 litros?", text: "O valor da diária para betoneira 120 litros começa a partir de R$ 80,00, com descontos para locações semanais e mensais." },
    { name: "Qual a capacidade de uma betoneira de 120 litros?", text: "A betoneira de 120 litros tem tambor de 120 litros e capacidade de mistura de cerca de 80 litros por batida, com produção estimada de até 2 m³ de concreto por dia." },
    { name: "Para qual tipo de obra a betoneira 120 litros é indicada?", text: "Ela é ideal para pequenas reformas, construções residenciais simples, calçadas e muros de arrimo." },
    { name: "A betoneira 120 litros inclui motor?", text: "Sim, todas as betoneiras são entregues com motor funcionando perfeitamente e garantia durante a locação." },
    { name: "Qual o prazo mínimo de locação?", text: "O prazo mínimo é de 1 dia. Oferecemos descontos especiais para locações semanais e mensais." },
  ],
  'betoneira-150l': [
    { name: "Quanto custa alugar uma betoneira 150 litros?", text: "O valor da diária para betoneira 150 litros começa a partir de R$ 100,00, com descontos para locações semanais e mensais." },
    { name: "Qual a capacidade de uma betoneira de 150 litros?", text: "A betoneira de 150 litros tem tambor de 150 litros e capacidade de mistura de cerca de 100 litros por batida, com produção estimada de até 3 m³ de concreto por dia." },
    { name: "Qual a diferença entre betoneira 120L e 150L?", text: "A betoneira 150 litros tem maior capacidade de mistura e produção, sendo ideal para obras residenciais de médio porte e reformas comerciais." },
    { name: "A betoneira 150L precisa de tomada 220V?", text: "Sim, o motor elétrico de 1 CV opera em 220V monofásico. Garanta uma tomada adequada perto do local de uso ou peça o modelo a gasolina no orçamento." },
    { name: "A entrega está incluída no valor da locação?", text: "O frete de entrega e retirada é calculado por distância e informado no orçamento. Região Norte do Rio tem frete reduzido." },
    { name: "Posso trocar de modelo durante a locação?", text: "Sim, é possível fazer upgrade para modelos maiores durante a locação, pagando apenas a diferença proporcional." },
  ],
  'betoneira-200l': [
    { name: "Quanto custa uma betoneira de 200 litros para alugar?", text: "O valor da diária para betoneira 200 litros começa a partir de R$ 130,00, com descontos para locações semanais e mensais." },
    { name: "Para qual tipo de obra a betoneira 200 litros é indicada?", text: "Ela é ideal para construções residenciais de grande porte, reformas extensas e pequenos empreendimentos comerciais." },
    { name: "Qual a produção diária da betoneira 200 litros?", text: "A betoneira 200 litros produz até 5 m³ de concreto por dia, com motor de 2 CV." },
    { name: "É melhor alugar duas 150L ou uma 200L?", text: "Para um único ponto de concreto, a betoneira 200 litros é mais econômica e prática de operar." },
  ],
  'betoneira-250l': [
    { name: "Quanto custa alugar uma betoneira 250 litros?", text: "O valor do aluguel de betoneira 250 litros é sob consulta: depende do prazo da locação, do endereço de entrega e do frete. Peça seu orçamento gratuito pelo WhatsApp." },
    { name: "Qual a capacidade de uma betoneira de 250 litros?", text: "O tambor tem 250 litros. Modelos de 250 litros costumam ter de 170 a 200 litros de capacidade de mistura, motor elétrico de 1 CV (variações de 3/4 a 1,5 CV), peso entre 130 e 165 kg e cerca de 15 ciclos por hora. São valores de referência: confirme o modelo disponível pelo WhatsApp, que envia a ficha técnica junto com o orçamento." },
    { name: "Quanto concreto faz uma betoneira de 250 litros?", text: "Fabricantes de modelos de 250 litros informam cerca de 15 ciclos por hora e produção nominal de cerca de 3 m³ por hora. A produção do dia depende das horas de uso e do ritmo da equipe; na nossa frota ela fica entre a 200L (até 5 m³ por dia) e a 400L (até 10 m³ por dia)." },
    { name: "A betoneira 250 litros é elétrica ou a gasolina?", text: "Modelos de 250 litros costumam usar motor elétrico monofásico de 1 CV (variações de 3/4 a 1,5 CV), em 110 ou 220V, e existem versões a combustão de 5 a 5,5 CV. A versão disponível para locação é confirmada pelo WhatsApp." },
    { name: "Para qual obra a betoneira 250 litros é indicada?", text: "Ela é indicada para obras residenciais maiores, reformas extensas e pequenas obras comerciais em que a betoneira de 200 litros fica curta, mas a de 400 litros seria grande demais." },
    { name: "É melhor alugar uma 250L ou uma 200L?", text: "Se a 200 litros atende o volume diário da obra com folga, ela costuma ser suficiente. Se a obra pede mais capacidade por batida, a 250 litros é o passo seguinte. Informe o volume pelo WhatsApp que a equipe indica o modelo." },
    { name: "A entrega está incluída no valor da locação?", text: "O frete de entrega e retirada é calculado por distância e informado no orçamento." },
  ],
  'betoneira-400l': [
    { name: "Quanto custa uma betoneira de 400 litros para alugar?", text: "O valor da diária para betoneira 400 litros começa a partir de R$ 250,00, com descontos para locações semanais e mensais." },
    { name: "Quanto concreto faz uma betoneira de 400 litros?", text: "A betoneira de 400 litros produz até 10 m³ de concreto por dia, com capacidade de mistura de cerca de 260 litros por batida." },
    { name: "Quantos m³ tem uma betoneira de 400 litros?", text: "O tambor tem 400 litros (0,4 m³) e a capacidade de mistura é de cerca de 260 litros por batida." },
    { name: "Para qual tipo de obra a betoneira 400 litros é indicada?", text: "Ela é ideal para construções comerciais, usinas de concreto temporárias, grandes reformas e empreendimentos de grande porte." },
    { name: "É melhor alugar uma 400L ou duas de 200L?", text: "Se a obra tem um único ponto de concreto, a betoneira 400 litros é mais econômica. Para dois pontos distantes, duas de 200L podem fazer sentido." },
  ],
};

const faqItems = (faqData[servico.slug] ?? []).map((q) => ({ question: q.name, answer: q.text }));
---

<Layout title={title} description={description} keywords={keywords} canonical={`/servicos/${servico.slug}/`} schema={productSchema} faq={faqItems} pageType="ItemPage" breadcrumbName={servico.data.title} preloadHero={false}>
  <Header currentPath="/servicos" />


  <main>
    <!-- HERO DO SERVIÇO -->
    <section class="relative py-24 lg:py-32 bg-gray-900 overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/hero-blur-1200.webp"
          srcset="/images/hero-blur-640.webp 640w, /images/hero-blur-960.webp 960w, /images/hero-blur-1200.webp 1200w"
          sizes="100vw"
          alt="Betoneira em obra de construção civil no Rio de Janeiro"
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="800"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-[#1A1A1A]/90 via-[#2D2D2D]/85 to-[#4A4A4A]/75"></div>
      </div>

      <div class="relative container mx-auto px-6 sm:px-8 lg:px-12 max-w-5xl">
        <div class="flex items-center gap-3 text-sm text-gray-100 mb-6">
          <a href="/servicos/" class="hover:text-primary transition-colors">Serviços</a>
          <span>/</span>
          <span class="text-white">{servico.data.title}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-16">
          {servico.data.title}
        </h1>

        <p class="text-lg text-gray-100 max-w-2xl mb-10">
          {servico.data.description}
        </p>

        <div class="flex flex-wrap gap-4">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-4 py-2 text-sm font-medium text-primary-300 ring-1 ring-inset ring-primary/20">
            Capacidade: {servico.data.capacidade}
          </span>
          <span class="inline-flex items-center rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-inset ring-white/20">
            Motor: {servico.data.motor ?? 'consulte a ficha técnica'}
          </span>
          <span class="inline-flex items-center rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-inset ring-white/20">
            Peso: {servico.data.peso ?? 'consulte a ficha técnica'}
          </span>
        </div>
      </div>
    </section>

    <!-- ESPECIFICAÇÕES + BENEFÍCIOS + CTA -->
    <section class="py-24 lg:py-32 bg-white">
      <div class="container mx-auto px-6 sm:px-8 lg:px-12 max-w-5xl">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <div class="lg:col-span-2">
            <!-- Especificações Técnicas -->
            <div class="mb-16">
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8">
                Ficha Técnica Resumida
              </h2>

              <div class="rounded-2xl border border-gray-200 section-concrete overflow-hidden">
                <div class="grid grid-cols-1 sm:grid-cols-2">
                  <div class="p-6 border-b sm:border-b-0 sm:border-r border-gray-200 transition-all hover:bg-gray-100">
                    <p class="text-sm text-gray-500 mb-1">Capacidade do Tambor</p>
                    <p class="text-lg font-bold text-gray-900">{servico.data.capacidade}</p>
                  </div>
                  <div class="p-6 border-b border-gray-200 transition-all hover:bg-gray-100">
                    <p class="text-sm text-gray-500 mb-1">Motor</p>
                    <p class="text-lg font-bold text-gray-900">{servico.data.motor ?? 'Consulte a ficha técnica'}</p>
                  </div>
                  <div class="p-6 border-b sm:border-b-0 sm:border-r border-gray-200 transition-all hover:bg-gray-100">
                    <p class="text-sm text-gray-500 mb-1">Peso Aproximado</p>
                    <p class="text-lg font-bold text-gray-900">{servico.data.peso ?? 'Consulte a ficha técnica'}</p>
                  </div>
                  <div class="p-6 transition-all hover:bg-gray-100">
                    <p class="text-sm text-gray-500 mb-1">Garantia</p>
                    <p class="text-lg font-bold text-gray-900">Durante toda a locação</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Conteúdo -->
            <div class="mb-16">
              <article class="prose prose-lg prose-gray max-w-none">
                <Content />
              </article>
              <FAQSection items={faqItems} />
            </div>

            <!-- Benefícios -->
            <div class="mb-16">
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8">
                Benefícios da Locação
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="flex items-start gap-4 p-6 rounded-xl section-concrete transition-all hover:shadow-md hover:scale-[1.02] reveal">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/20 text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Sem investimento alto</h3>
                    <p class="text-sm text-gray-600">Alugue pelo tempo que precisar sem comprar o equipamento.</p>
                  </div>
                </div>
                <div class="flex items-start gap-4 p-6 rounded-xl section-concrete transition-all hover:shadow-md hover:scale-[1.02] reveal">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/20 text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Manutenção zero</h3>
                    <p class="text-sm text-gray-600">Nós cuidamos da revisão. Você só usa.</p>
                  </div>
                </div>
                <div class="flex items-start gap-4 p-6 rounded-xl section-concrete transition-all hover:shadow-md hover:scale-[1.02] reveal">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/20 text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Entrega rápida</h3>
                    <p class="text-sm text-gray-600">Receba no mesmo dia em toda a região.</p>
                  </div>
                </div>
                <div class="flex items-start gap-4 p-6 rounded-xl section-concrete transition-all hover:shadow-md hover:scale-[1.02] reveal">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/20 text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Suporte técnico</h3>
                    <p class="text-sm text-gray-600">Atendimento prioritário durante a locação.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar Preços + CTA -->
          <div class="lg:col-span-1">
            <div class="sticky top-24 space-y-6">
              <div class="rounded-2xl border border-gray-200 section-concrete p-10 transition-all hover:shadow-lg">
                <h2 class="text-xl font-bold text-gray-900 mb-6">Solicite um Orçamento</h2>
                <p class="text-gray-600 mb-8">Entre em contato para receber valores atualizados e condições especiais para o seu projeto.</p>

                <a
                  href="/contato/"
                  class="block w-full text-center rounded-full bg-secondary px-6 py-4 text-base font-bold text-white shadow-lg shadow-secondary/30 hover:bg-secondary-700 hover:scale-105 active:scale-95 transition-all mb-4"
                >
                  Solicitar Orçamento
                </a>

                <a
                  href={whatsappUrl} data-evento="clique_whatsapp" data-local={`servico-${servico.slug}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full text-center rounded-full bg-whatsapp px-6 py-4 text-base font-bold text-white shadow-lg shadow-whatsapp/30 hover:bg-whatsapp-dark hover:scale-105 active:scale-95 transition-all"
                >
                  Falar no WhatsApp
                </a>

                <p class="mt-6 text-sm text-gray-500 text-center">
                  Entrega e retirada na cidade do Rio de Janeiro.
                </p>
              </div>

              <!-- CTA Extra -->
              <div class="rounded-2xl bg-secondary p-10 text-center transition-all hover:shadow-lg hover:scale-[1.02]">
                <h3 class="text-lg font-bold text-white mb-3">Não sabe qual escolher?</h3>
                <p class="text-gray-100 text-sm mb-6">Nossa equipe ajuda a escolher o equipamento ideal para sua obra.</p>
                <a
                  href={SITE_CONFIG.telefoneLink} data-evento="clique_telefone" data-local={`servico-${servico.slug}`}
                  class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-bold text-secondary hover:bg-gray-100 hover:scale-105 active:scale-95 transition-all shadow-lg"
                >
                  Ligar Agora
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
