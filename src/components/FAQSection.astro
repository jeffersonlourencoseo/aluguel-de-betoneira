---
/** FAQ visivel. Recebe os mesmos itens enviados ao schema FAQPage (texto identico). */
interface Props {
  items: Array<{ question: string; answer: string }>;
  title?: string;
}
const { items, title = 'Perguntas frequentes' } = Astro.props;
---

{
  items.length >= 2 && (
    <section class="mt-16 border-t border-gray-200 pt-12" aria-labelledby="faq-titulo">
      <h2 id="faq-titulo" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8">{title}</h2>
      <div class="space-y-8">
        {items.map((item) => (
          <div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{item.question}</h3>
            <p class="text-gray-600 leading-relaxed max-w-prose">{item.answer}</p>
          </div>
        ))}
      </div>
    </section>
  )
}
